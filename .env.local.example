# ==============================================================================
# ULTRON AI Assistant Configuration
# (Optional: If no key is configured, ULTRON's built-in offline engine will respond)
# ==============================================================================

# Option 1: Google Gemini 3.8 Live (Recommended for Real-time Voice)
GEMINI_API_KEY=your-gemini-key-here
# Models: gemini-3.8-live (default real-time audio), gemini-3.8-live-extended-thinking, gemini-3.8-flash
GEMINI_MODEL=gemini-3.8-live
# Prebuilt Live Voices: Puck, Nova, Orion, Capella, Fenrir, Aoede, Charon, Kore, Vega
GEMINI_VOICE=Puck

# Option 2: Anthropic Claude
# ANTHROPIC_API_KEY=your-anthropic-key-here
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Option 3: OpenAI / Groq / OpenRouter / DeepSeek
# OPENAI_API_KEY=your-openai-or-groq-key-here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# ==============================================================================
# Text-to-Speech (TTS) Voice Configuration
# (By default, ULTRON uses Gemini 3.8 Live native audio or built-in audible speech.
# If OPENAI_API_KEY is provided, OpenAI's neural TTS will also be supported)
# ==============================================================================
# OPENAI_TTS_VOICE=onyx # Options: onyx (deep/Jarvis), echo, alloy, fable, nova, shimmer
